# Copy to .env on Hostinger server and fill in values
# (Same values as Vercel Project → Settings → Environment Variables)

PORT=5608
HOST=0.0.0.0
NODE_ENV=production

# Required — MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/bitunix

# Auth
JWT_SECRET=your-long-random-secret-here

# Admin login (optional — or set in MongoDB admin_settings)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=YourSecureAdminPassword123!

# Email (password reset)
SMTP_HOST=mail.bitunixpk.com
SMTP_PORT=465
SMTP_USER=support@bitunixpk.com
SMTP_PASS=your-email-password
