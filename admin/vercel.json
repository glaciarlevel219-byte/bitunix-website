{
  "version": 2,
  "name": "bitunix-admin",
  "framework": null,
  "buildCommand": null,
  "outputDirectory": null,
  "devCommand": "node admin-server-fixed.js",
  "installCommand": "npm install",
  "functions": {
    "admin-server-fixed.js": {
      "maxDuration": 30
    }
  },
  "routes": [
    {
      "src": "/admin/api/(.*)",
      "dest": "/admin-server-fixed.js"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
